// Shows FARM_FRAME (sketch/frame.h, generated by `farm-verifier show`) on the 8x13 matrix.
// Core-only on purpose: the Uno Q has no internet, so sketches cannot pull libraries
// such as Arduino_RouterBridge; Arduino_LED_Matrix ships with the arduino:zephyr core.
#include <Arduino_LED_Matrix.h>
#include "frame.h"

Arduino_LED_Matrix matrix;

void setup() {
  matrix.begin();
  matrix.setGrayscaleBits(1);  // FARM_FRAME holds 0/1 per pixel, row-major
  matrix.draw(FARM_FRAME);
}

void loop() {
  delay(1000);
}
